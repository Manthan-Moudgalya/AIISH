{
    "installCommand": "npm i --legacy-peer-deeps",
    "version": 2,
    "builds": [
        {
            "src":"/api/index.mjs",
            "use": "@vercel/node"
        }, 
        {
            "src":"src/**/*",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {"src": "/(.*)", "dest": "/"}
    ]
}